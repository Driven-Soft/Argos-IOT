    {
        "id": "ch-uptime",
        "type": "change",
        "z": "tab-argos",
        "name": "Extrair uptime_s",
        "rules": [
            {
                "t": "set",
                "p": "payload",
                "pt": "msg",
                "to": "payload.uptime_s",
                "tot": "msg"
            }
