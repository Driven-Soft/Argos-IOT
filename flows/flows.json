    {
        "id": "fn-nivel",
        "type": "function",
        "z": "tab-argos",
        "name": "Formatar nivel",
        "func": "const m = {\n  baixo:   '\\uD83D\\uDFE2 BAIXO',\n  medio:   '\\uD83D\\uDFE1 MEDIO',\n  alto:    '\\uD83D\\uDFE0 ALTO',\n  critico: '\\uD83D\\uDD34 CRITICO'\n};\nmsg.payload = m[msg.payload] || String(msg.payload).toUpperCase();\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 760,
        "y": 320,
        "wires": [
            [
                "txt-nivel"
            ]
        ]
    },
