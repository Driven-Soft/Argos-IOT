        "type": "function",
        "z": "tab-argos",
        "name": "Formatar online",
        "func": "msg.payload = (msg.payload === true || msg.payload === 'true') ? '\\uD83D\\uDFE2 ONLINE' : '\\uD83D\\uDD34 OFFLINE';\nreturn msg;",
