        "x": 560,
        "y": 640,
        "wires": [
            [
                "fn-uptime"
            ]
        ]
    },
    {
        "id": "fn-uptime",
        "type": "function",
        "z": "tab-argos",
        "name": "Formatar uptime",
        "func": "let s = parseInt(msg.payload) || 0;\nlet h = Math.floor(s / 3600);\nlet m = Math.floor((s % 3600) / 60);\nlet sec = s % 60;\nmsg.payload = `${h}h ${m}m ${sec}s`;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 765,
        "y": 640,
        "wires": [
            [
                "txt-uptime"
            ]
        ]
    },
